# The repository that holds the posts, as "owner/name".
PLUTO_CMS_REPO=your-name/your-blog
# PLUTO_CMS_BRANCH=main
# The URL name of your GitHub App (github.com/apps/<slug>).
PLUTO_CMS_APP_SLUG=your-blog-cms

# Secrets. Keep them out of git. See "Set up the CMS" in README.md.
# 32 characters or more. Generate one with: openssl rand -base64 32
NUXT_PLUTO_CMS_SESSION_PASSWORD=
NUXT_PLUTO_CMS_GITHUB_APP_ID=
NUXT_PLUTO_CMS_GITHUB_CLIENT_ID=
NUXT_PLUTO_CMS_GITHUB_CLIENT_SECRET=
# The private key of the GitHub App, on one line with \n for line breaks.
NUXT_PLUTO_CMS_GITHUB_PRIVATE_KEY=
# Optional: only these GitHub logins can sign in (comma-separated).
# NUXT_PLUTO_CMS_ALLOWED_USERS=

# Development: test against GitHub instead of the local content/ folder.
# PLUTO_CMS_STORAGE=github
# Development: use a local checkout of Pluto.
# PLUTO_PLUTO_PATH=../pluto
